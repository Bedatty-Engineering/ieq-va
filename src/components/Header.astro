---
interface NavItem {
  href: string;
  label: string;
}

const navItems: NavItem[] = [
  { href: "/", label: "Home" },
  { href: "/sobre", label: "Sobre" },
  { href: "/grupos", label: "Grupos" },
  { href: "/cronograma", label: "Cronograma" },
  { href: "/localizacao", label: "Localização" }
];

const currentPath = Astro.url.pathname;
const isOverlayHeader = currentPath === "/";
---

<header
  id="site-header"
  data-overlay-header={isOverlayHeader ? "true" : "false"}
  class:list={["site-header", !isOverlayHeader && "is-scrolled"]}
>
  <div class="w-full pt-0">
    <div class="header-shell">
      <div class="site-container flex items-center justify-between gap-4 sm:px-0">
        <a href="/" class="flex max-w-max items-center gap-4">
          <img
            src="/images/LOGO_QUADRANGULAR_ATUAL.png"
            alt="Logo da 5ª Igreja do Evangelho Quadrangular de Vila Arlindo"
            class="brand-logo h-14 w-auto max-w-[16rem] object-contain sm:h-16 sm:max-w-[18rem]"
          />
          <div class="header-brand-copy hidden min-[940px]:block">
            <p class="text-xs font-semibold uppercase tracking-[0.28em] text-white/65">5IEQ</p>
            <p class="text-xl font-semibold uppercase tracking-[0.14em] text-white">Vila Arlindo</p>
          </div>
        </a>

        <button
          type="button"
          class="menu-toggle md:hidden"
          aria-expanded="false"
          aria-controls="site-nav"
          aria-label="Abrir menu"
          data-menu-toggle
        >
          <span></span>
          <span></span>
          <span></span>
        </button>

        <div class="site-nav-backdrop" data-menu-backdrop></div>

        <nav id="site-nav" aria-label="Navegação principal" class="site-nav" data-site-nav>
          {
            navItems.map((item) => (
              <a
                href={item.href}
                aria-current={currentPath === item.href ? "page" : undefined}
                style={`--nav-item-index:${navItems.indexOf(item)};`}
                class:list={[
                  "nav-link",
                  currentPath === item.href && "nav-link-active"
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const header = document.getElementById("site-header");
  const isOverlayHeader = header?.dataset.overlayHeader === "true";
  const hero = document.getElementById("home-hero");
  const menuToggle = header?.querySelector("[data-menu-toggle]");
  const nav = header?.querySelector("[data-site-nav]");
  const backdrop = header?.querySelector("[data-menu-backdrop]");
  const navLinks = nav ? Array.from(nav.querySelectorAll("a")) : [];

  const closeMenu = () => {
    if (!header || !menuToggle) return;
    header.classList.remove("menu-open");
    document.body.classList.remove("menu-open");
    menuToggle.setAttribute("aria-expanded", "false");
    menuToggle.setAttribute("aria-label", "Abrir menu");
  };

  const openMenu = () => {
    if (!header || !menuToggle) return;
    header.classList.add("menu-open");
    document.body.classList.add("menu-open");
    menuToggle.setAttribute("aria-expanded", "true");
    menuToggle.setAttribute("aria-label", "Fechar menu");
  };

  const toggleMenu = () => {
    if (!header?.classList.contains("menu-open")) {
      openMenu();
      return;
    }

    closeMenu();
  };

  const syncHeader = () => {
    if (!header) return;
    if (!isOverlayHeader) {
      header.classList.add("is-scrolled");
      return;
    }

    if (!hero) {
      header.classList.toggle("is-scrolled", window.scrollY > 24);
      return;
    }

    const heroBottom = hero.getBoundingClientRect().bottom;
    const headerHeight = header.getBoundingClientRect().height;
    header.classList.toggle("is-scrolled", heroBottom <= headerHeight);
  };

  syncHeader();
  window.addEventListener("scroll", syncHeader, { passive: true });

  menuToggle?.addEventListener("click", toggleMenu);
  backdrop?.addEventListener("click", closeMenu);
  navLinks.forEach((link) => link.addEventListener("click", closeMenu));
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 768) {
      closeMenu();
    }
  });
  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeMenu();
    }
  });
</script>
