---
export interface TimelineItem {
  title: string;
  description: string;
  year?: string;
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<ol class="relative space-y-8 border-l border-line pl-5 sm:space-y-10 sm:pl-6">
  {
    items.map((item) => (
      <li class="relative">
        <span class="absolute -left-[1.55rem] top-1.5 h-3.5 w-3.5 rounded-full border-[3px] border-surface bg-accent sm:-left-[1.95rem] sm:h-4 sm:w-4 sm:border-4"></span>
        {item.year && <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">{item.year}</p>}
        <h3 class="mt-2 font-serif text-2xl font-semibold leading-none tracking-[-0.03em] text-text sm:text-3xl">{item.title}</h3>
        <p class="mt-3 text-sm leading-7 text-muted sm:text-base sm:leading-8">{item.description}</p>
      </li>
    ))
  }
</ol>
