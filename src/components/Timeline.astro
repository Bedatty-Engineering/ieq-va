---
export interface TimelineItem {
  title: string;
  description: string;
  year?: string;
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<ol class="relative space-y-10 border-l border-line pl-6">
  {
    items.map((item) => (
      <li class="relative">
        <span class="absolute -left-[1.95rem] top-1.5 h-4 w-4 rounded-full border-4 border-surface bg-accent"></span>
        {item.year && <p class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">{item.year}</p>}
        <h3 class="mt-2 font-serif text-3xl font-semibold leading-none tracking-[-0.03em] text-text">{item.title}</h3>
        <p class="mt-3 text-base leading-8 text-muted">{item.description}</p>
      </li>
    ))
  }
</ol>
