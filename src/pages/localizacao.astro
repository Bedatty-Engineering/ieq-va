---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { MapPin, Navigation, Clock, ArrowUpRight } from "@lucide/astro";

const programacaoEntries = (await getCollection("localizacaoProgramacao"))
  .filter((entry) => entry.data.published)
  .sort((left, right) => left.data.order - right.data.order);

const programacao = await Promise.all(
  programacaoEntries.map(async (entry) => {
    const { Content } = await render(entry);

    return {
      id: entry.id,
      ...entry.data,
      Content
    };
  })
);

const faqEntries = (await getCollection("localizacaoFaq"))
  .filter((entry) => entry.data.published)
  .sort((left, right) => left.data.order - right.data.order);

const faqItems = await Promise.all(
  faqEntries.map(async (entry) => {
    const { Content } = await render(entry);

    return {
      id: entry.id,
      ...entry.data,
      Content
    };
  })
);
---

<BaseLayout
  title="Localização | 5IEQ Vila Arlindo"
  description="Veja a referência de localização e a programação da Igreja Quadrangular Vila Arlindo."
>
  <section class="site-container pb-10 pt-24 sm:pb-16 sm:pt-32">
    <div class="page-hero p-6 text-center sm:p-12">
      <p class="section-kicker">Localização e Horários</p>
      <h1 class="mt-4 font-serif text-4xl font-semibold leading-[0.95] tracking-[-0.04em] text-text sm:text-6xl">
        Venha nos visitar. Estamos de portas abertas para receber você.
      </h1>
      <p class="mx-auto mt-6 max-w-3xl section-copy">
        Abaixo estão o ponto oficial no Google Maps, os horários públicos da igreja e um mapa para
        facilitar a sua chegada até a 5ª Igreja do Evangelho Quadrangular de Vila Arlindo.
      </p>
    </div>
  </section>

  <section class="site-container pb-12 sm:pb-16">
    <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="section-card min-h-[320px] overflow-hidden sm:min-h-[480px]">
        <iframe
          title="Mapa da 5ª Igreja do Evangelho Quadrangular de Vila Arlindo"
          src="https://maps.google.com/maps?q=-29.6458463,-52.2960489&t=k&z=17&ie=UTF8&iwloc=&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="block h-full min-h-[320px] w-full border-0 sm:min-h-[480px]"
        ></iframe>
      </div>

      <article class="section-card p-6 sm:p-10">
        <p class="section-kicker">Informações</p>
        <h2 class="mt-4 font-serif text-3xl font-semibold leading-none text-text sm:text-4xl">Como chegar e quando participar</h2>

        <div class="mt-8 space-y-6">
          <div class="info-item">
            <div class="icon-card-row">
              <span class="icon-badge-sm" aria-hidden="true">
                <MapPin class="icon-svg" stroke-width={1.9} />
              </span>
              <div>
                <p class="section-kicker">Endereço</p>
                <address class="mt-2 not-italic text-base leading-7 text-muted">
                  5ª Igreja do Evangelho Quadrangular de Vila Arlindo<br />
                  Vila Arlindo<br />
                  Venâncio Aires - RS
                </address>
              </div>
            </div>
          </div>

          <div class="info-item">
            <div class="icon-card-row">
              <span class="icon-badge-sm shrink-0" aria-hidden="true">
                <Navigation class="h-4 w-4" stroke-width={1.9} />
              </span>
              <div>
                <p class="section-kicker">Como chegar</p>
                <p class="mt-2 text-base leading-7 text-muted">
                  Use o botão abaixo para abrir a rota diretamente no Google Maps com o ponto já
                  confirmado da igreja.
                </p>
              </div>
            </div>
          </div>
        </div>

        <a
          href="https://www.google.com/maps/place/5%C2%AA+Igreja+do+Evangelho+Quadrangular+de+Vila+Arlindo/@-29.6458416,-52.2986292,17z/data=!3m1!4b1!4m6!3m5!1s0x951c971cdc06b81d:0xbd292610bdb25035!8m2!3d-29.6458463!4d-52.2960489!16s%2Fg%2F11vhtm1f9m"
          target="_blank"
          rel="noreferrer"
          class="mt-8 inline-flex w-full justify-center rounded-full bg-accent px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#8e5e24] sm:w-auto"
        >
          Abrir rota no Google Maps
        </a>
      </article>
    </div>
  </section>

  <section class="site-container pb-10 sm:pb-16">
    <div class="mb-8">
      <p class="section-kicker">Programação</p>
      <h2 class="mt-3 font-serif text-3xl font-semibold leading-none text-text sm:text-4xl">
        Encontros regulares ao longo da semana e do mês.
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        programacao.map((item) => (
          <article class="feature-card">
            <div class="flex items-center gap-3">
              <span class="icon-badge shrink-0" aria-hidden="true">
                <Clock class="icon-svg-lg" stroke-width={1.9} />
              </span>
              <p class="section-kicker">{item.schedule}</p>
            </div>
            <h2 class="font-serif text-3xl font-semibold text-text">{item.title}</h2>
            {
              item.summary ? (
                <p class="mt-3 text-base leading-7 text-muted">{item.summary}</p>
              ) : (
                <div class="mt-3 markdown-copy text-muted">
                  <item.Content />
                </div>
              )
            }
          </article>
        ))
      }
    </div>

    <a
      href="https://www.instagram.com/5ieq.vilaarlindo/"
      target="_blank"
      rel="noreferrer"
      class="feature-card mt-6 flex flex-col gap-4 transition hover:border-accent/40 active:scale-[0.98] active:brightness-95 cursor-pointer md:flex-row md:items-center md:justify-between"
    >
      <div class="flex items-center gap-4">
        <span class="icon-badge shrink-0" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" class="icon-svg-lg" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5"/>
            <circle cx="12" cy="12" r="5"/>
            <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/>
          </svg>
        </span>
        <div>
          <p class="section-kicker">Instagram</p>
          <p class="mt-1 font-serif text-2xl font-semibold text-text">@5ieq.vilaarlindo</p>
          <p class="mt-1 text-sm leading-6 text-muted">Acompanhe a programação e os avisos públicos.</p>
        </div>
      </div>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-white transition shrink-0">
        Visitar perfil
        <ArrowUpRight class="h-4 w-4" stroke-width={2} />
      </span>
    </a>
  </section>

  <section class="site-container pb-14 sm:pb-20">
    <div class="grid gap-6 md:grid-cols-[0.9fr_1.1fr]">
      <article class="section-card p-6 md:p-10">
        <p class="section-kicker">Perguntas Frequentes</p>
        <div class="mt-6 space-y-4">
          {
            faqItems.map((item) => (
              <div class="info-item">
                <h3 class="font-serif text-2xl font-semibold text-text">{item.question}</h3>
                <div class="mt-2 markdown-copy text-muted">
                  <item.Content />
                </div>
              </div>
            ))
          }
        </div>
      </article>

      <article class="media-block overflow-hidden">
        <img
          src="/images/vila-arlindo.jpeg"
          alt="Entrada da Igreja Quadrangular Vila Arlindo"
          class="h-72 w-full object-cover object-[58%_center] md:h-full"
        />
      </article>
    </div>
  </section>
</BaseLayout>
