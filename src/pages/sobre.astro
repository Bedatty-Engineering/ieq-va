---
import Timeline from "../components/Timeline.astro";
import {
  aboutTimelineItems,
  aboutValues,
  churchInfo
} from "../features/institucional/content/siteContent";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Sobre | 5IEQ Vila Arlindo"
  description="Conheça a história e a identidade da Igreja Quadrangular Vila Arlindo."
>
  <section class="site-container pb-12 pt-28 sm:pb-16 sm:pt-32">
    <div class="page-hero">
      <div class="grid gap-0 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="p-8 sm:p-12 lg:p-14">
          <p class="section-kicker">Sobre a Igreja</p>
          <h1 class="mt-4 font-serif text-4xl font-semibold leading-[0.95] tracking-[-0.04em] text-text sm:text-6xl">
            Nossa história e nossa missão.
          </h1>
          <p class="mt-6 max-w-2xl section-copy">
            Esta página reúne a base institucional da igreja: trajetória, missão, visão e valores.
          </p>
          <div class="eyebrow-rule"></div>
        </div>
        <div class="min-h-[280px]">
          <img
            src={churchInfo.imagePath}
            alt="Fachada da Igreja Quadrangular Vila Arlindo"
            class="h-full w-full object-cover object-[58%_center]"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="site-container pb-12 sm:pb-16">
    <div class="grid gap-6 lg:grid-cols-2">
      <article class="section-card p-8 sm:p-10">
        <p class="section-kicker">Quem Somos</p>
        <h2 class="mt-4 font-serif text-4xl font-semibold leading-none text-text">Uma igreja institucional, acolhedora e presente na comunidade.</h2>
        <div class="mt-6 space-y-5 text-base leading-8 text-muted">
          <p>
            A comunidade local foi construída com encontros simples, constância pastoral e
            fidelidade à mensagem bíblica.
          </p>
          <p>
            Ao longo do tempo, a igreja consolidou uma identidade marcada por reverência,
            hospitalidade e serviço.
          </p>
          <p>
            A linha do tempo e os valores abaixo resumem essa caminhada de forma direta.
          </p>
        </div>
      </article>

      <article class="section-card p-8 sm:p-10">
        <p class="section-kicker">Missão e Visão</p>
        <div class="mt-6 grid gap-4">
          <div class="info-item">
            <h3 class="font-serif text-3xl font-semibold text-text">Missão</h3>
            <p class="mt-3 text-base leading-8 text-muted">
              Anunciar o evangelho, fortalecer famílias e servir a comunidade com base na Palavra.
            </p>
          </div>
          <div class="info-item">
            <h3 class="font-serif text-3xl font-semibold text-text">Visão</h3>
            <p class="mt-3 text-base leading-8 text-muted">
              Permanecer como uma igreja reconhecida por acolhimento, constância espiritual e
              presença fiel em Vila Arlindo.
            </p>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="site-container pb-12 sm:pb-16">
    <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
      <article class="section-card p-8 sm:p-10">
        <p class="section-kicker">Nossos Valores</p>
        <div class="mt-6 space-y-4">
          {
            aboutValues.map((item) => (
              <div class="info-item">
                <h3 class="font-serif text-2xl font-semibold text-text">{item.title}</h3>
                <p class="mt-2 text-base leading-7 text-muted">{item.description}</p>
              </div>
            ))
          }
        </div>
      </article>

      <article class="section-card p-8 sm:p-10">
        <p class="section-kicker">Linha do Tempo</p>
        <div class="mt-6">
          <Timeline items={aboutTimelineItems} />
        </div>
      </article>
    </div>
  </section>

  <section class="bg-[#3a2f26] py-16 text-white sm:py-20">
    <div class="site-container text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.28em] text-amber-200/70">Faça parte</p>
      <h2 class="mt-4 font-serif text-4xl font-semibold leading-none sm:text-5xl">Venha conhecer a comunidade local</h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-stone-300">
        Se o próximo passo for visitar a igreja, a página de localização reúne mapa, endereço e
        horários.
      </p>
      <div class="mt-10">
        <a href="/localizacao" class="button-primary">Ver localização e horários</a>
      </div>
    </div>
  </section>
</BaseLayout>
