---
import { Users, Clock, User } from "@lucide/astro";
import { getGruposPageData } from "../features/grupos/content/getGruposPageData";
import BaseLayout from "../layouts/BaseLayout.astro";

const { groups } = await getGruposPageData();
---

<BaseLayout
  title="Grupos | 5IEQ Vila Arlindo"
  description="Conheça os grupos da 5IEQ Vila Arlindo para crianças, jovens, homens, mulheres e casais."
>
  <section class="site-container pb-12 pt-28 sm:pb-16 sm:pt-32">
    <div class="page-hero">
      <div class="grid gap-0 lg:grid-cols-[1.08fr_0.92fr]">
        <div class="p-8 sm:p-12 lg:p-14">
          <p class="section-kicker">Grupos da Igreja</p>
          <h1 class="mt-4 font-serif text-5xl font-semibold leading-[0.92] tracking-[-0.04em] text-text sm:text-6xl">
            Espaços de comunhão, cuidado e crescimento para cada fase da vida.
          </h1>
          <p class="mt-6 max-w-2xl section-copy">
            Nos cards abaixo você encontra cada grupo organizado por público e horário, facilitando
            a consulta do encontro mais adequado.
          </p>
          <div class="eyebrow-rule"></div>
        </div>

        <div class="flex min-h-[280px] items-center bg-[#eee4d5] p-8 sm:p-12">
          <div class="w-full rounded-[1.75rem] border border-white/60 bg-white/70 p-6 shadow-card sm:p-8">
            <span class="icon-badge" aria-hidden="true">
              <Users class="icon-svg-lg" stroke-width={1.9} />
            </span>
            <p class="section-kicker">Vida em comunidade</p>
            <h2 class="mt-4 font-serif text-4xl font-semibold leading-none text-text">
              Cada grupo atende uma fase da vida com cuidado mais próximo.
            </h2>
            <p class="mt-5 text-base leading-8 text-muted">
              O objetivo é tornar mais simples encontrar onde participar e acompanhar os encontros
              da igreja.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="site-container pb-12 sm:pb-16">
    <div class="mb-8">
      <p class="section-kicker">Encontros</p>
      <h2 class="mt-3 font-serif text-3xl font-semibold leading-none text-text sm:text-4xl">
        Escolha o grupo conforme o público e consulte o horário no próprio card.
      </h2>
    </div>

    <div class="grupo-grid">
      {
        groups.map((grupo, index) => (
          <article class:list={["grupo-card", index === 0 && "grupo-card-featured"]}>
            <div class="flex items-start justify-between gap-4">
              <span class="icon-badge shrink-0" aria-hidden="true">
                <Users class="icon-svg-lg" stroke-width={1.9} />
              </span>
              <p class="grupo-card-audience">{grupo.audience}</p>
            </div>

            <div class="mt-6">
              <h2 class="font-serif text-3xl font-semibold text-text">{grupo.title}</h2>
              <p class="mt-4 text-base leading-8 text-muted">{grupo.summary}</p>
            </div>

            <div class="grupo-card-schedule">
              <span class="icon-badge-sm shrink-0" aria-hidden="true">
                <Clock class="icon-svg" stroke-width={1.9} />
              </span>
              <span>{grupo.schedule}</span>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="site-container pb-12 sm:pb-16">
    <div class="grid gap-6 lg:grid-cols-[1fr_1fr]">
      <article class="section-card p-8 sm:p-10">
        <p class="section-kicker">Propósito</p>
        <h2 class="mt-4 font-serif text-4xl font-semibold leading-none text-text">
          Cada encontro reforça cuidado, comunhão e ensino bíblico.
        </h2>
        <div class="mt-6 space-y-5 text-base leading-8 text-muted">
          <p>
            Os grupos criam espaços mais próximos para oração, escuta e fortalecimento espiritual.
          </p>
          <p>
            Embora cada card destaque um público específico, todos fazem parte da mesma vida em
            comunidade da igreja.
          </p>
        </div>
      </article>

      <article class="section-card p-8 sm:p-10">
        <p class="section-kicker">Participação</p>
        <div class="mt-6 grid gap-4">
          <div class="info-item">
            <div class="icon-card-row">
              <span class="icon-badge-sm" aria-hidden="true">
                <User class="icon-svg" stroke-width={1.9} />
              </span>
              <div>
                <h3 class="font-serif text-2xl font-semibold text-text">Quem pode participar?</h3>
                <p class="mt-2 text-base leading-7 text-muted">
                  Veja o público indicado em cada card. Se tiver dúvida, a igreja pode orientar qual
                  encontro faz mais sentido para você.
                </p>
              </div>
            </div>
          </div>
          <div class="info-item">
            <div class="icon-card-row">
              <span class="icon-badge-sm" aria-hidden="true">
                <Clock class="icon-svg" stroke-width={1.9} />
              </span>
              <div>
                <h3 class="font-serif text-2xl font-semibold text-text">Como saber os horários?</h3>
                <p class="mt-2 text-base leading-7 text-muted">
                  Os horários principais estão nos cards acima. Para acompanhar a programação
                  pública completa, consulte também a página de localização.
                </p>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="bg-[#3a2f26] py-16 text-white sm:py-20">
    <div class="site-container text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.28em] text-amber-200/70">Participe</p>
      <h2 class="mt-4 font-serif text-4xl font-semibold leading-none sm:text-5xl">
        Encontre o grupo que acompanha a sua fase de vida.
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-stone-300">
        Se o próximo passo for visitar a igreja, a página de localização concentra mapa, endereço e
        horários públicos.
      </p>
      <div class="mt-10">
        <a href="/localizacao" class="button-primary">Ver localização e horários</a>
      </div>
    </div>
  </section>
</BaseLayout>
