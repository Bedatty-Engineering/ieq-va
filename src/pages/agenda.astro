---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CalendarDays, ChevronLeft, ChevronRight, ChevronDown, MoveRight, X, Clock, MapPin } from "@lucide/astro";

interface EventEntry {
  id: string;
  sourceId: string;
  parentSourceId?: string;
  title: string;
  startDate: Date;
  endDate: Date;
  location?: string;
  summary?: string;
  allDay: boolean;
  googleCalendarUrl: string;
  monthIndex: number;
  dayLabel: string;
  timeLabel: string;
  Content: Astro.ComponentFactory;
}

interface EventGroup extends EventEntry {
  subEvents: EventEntry[];
}

interface CalendarDay {
  key: string;
  dayNumber: number | null;
  isCurrentMonth: boolean;
  events: EventGroup[];
}

interface CalendarMonth {
  label: string;
  monthIndex: number;
  year: number;
  events: EventGroup[];
  days: CalendarDay[];
}

interface EventData {
  title: string;
  startDate: string;
  endDate?: string;
  parentId?: string;
  location?: string;
  summary?: string;
  allDay?: boolean;
  published?: boolean;
  recurrence?: {
    frequency: "weekly" | "monthlyNth";
    until: string;
    interval?: number;
    nth?: number;
    months?: number[];
    overrides?: {
      originalDate: string;
      startDate: string;
      endDate?: string;
    }[];
  };
}

const monthFormatter = new Intl.DateTimeFormat("pt-BR", { month: "long" });
const dayFormatter = new Intl.DateTimeFormat("pt-BR", { day: "2-digit" });
const timeFormatter = new Intl.DateTimeFormat("pt-BR", {
  hour: "2-digit",
  minute: "2-digit",
  timeZone: "America/Sao_Paulo"
});
const weekdayFormatter = new Intl.DateTimeFormat("pt-BR", {
  weekday: "long",
  timeZone: "America/Sao_Paulo"
});
const weekdayShortLabels = ["Dom", "Seg", "Ter", "Qua", "Qui", "Sex", "Sab"];

const calendarYear = new Date().getFullYear();
const monthLabels = Array.from({ length: 12 }, (_, index) =>
  monthFormatter
    .format(new Date(calendarYear, index, 1))
    .replace(/^\w/, (letter) => letter.toUpperCase())
);

function toGoogleDate(date: Date) {
  return date.toISOString().replace(/[-:]/g, "").replace(/\.\d{3}Z$/, "Z");
}

function toAllDayGoogleDate(date: Date) {
  return date.toISOString().slice(0, 10).replace(/-/g, "");
}

function toDateKey(date: Date) {
  return [
    date.getFullYear(),
    String(date.getMonth() + 1).padStart(2, "0"),
    String(date.getDate()).padStart(2, "0")
  ].join("-");
}

function buildGoogleCalendarUrl(event: {
  title: string;
  startDate: Date;
  endDate: Date;
  location?: string;
  summary?: string;
  allDay: boolean;
}) {
  const details = event.summary ?? "Evento da 5IEQ Vila Arlindo";
  const dates = event.allDay
    ? `${toAllDayGoogleDate(event.startDate)}/${toAllDayGoogleDate(event.endDate)}`
    : `${toGoogleDate(event.startDate)}/${toGoogleDate(event.endDate)}`;

  const params = new URLSearchParams({
    action: "TEMPLATE",
    text: event.title,
    dates,
    details
  });

  if (event.location) {
    params.set("location", event.location);
  }

  return `https://calendar.google.com/calendar/render?${params.toString()}`;
}

function cloneDate(date: Date) {
  return new Date(date.getTime());
}

function addDays(date: Date, days: number) {
  const value = cloneDate(date);
  value.setDate(value.getDate() + days);
  return value;
}

function addMonths(date: Date, months: number) {
  const value = cloneDate(date);
  value.setMonth(value.getMonth() + months);
  return value;
}

function getNthWeekdayDate(year: number, month: number, weekday: number, nth: number) {
  const firstDay = new Date(year, month, 1);
  const offset = (weekday - firstDay.getDay() + 7) % 7;
  const dayOfMonth = 1 + offset + (nth - 1) * 7;
  const candidate = new Date(year, month, dayOfMonth);

  return candidate.getMonth() === month ? candidate : null;
}

function mergeDateAndTime(date: Date, timeSource: Date) {
  const value = cloneDate(date);
  value.setHours(
    timeSource.getHours(),
    timeSource.getMinutes(),
    timeSource.getSeconds(),
    timeSource.getMilliseconds()
  );
  return value;
}

function buildOccurrence(startDate: Date, durationMs: number, allDay: boolean, endDate?: Date) {
  return {
    startDate,
    endDate: endDate ?? new Date(startDate.getTime() + durationMs),
    allDay
  };
}

function expandOccurrences(data: EventData) {
  const startDate = new Date(data.startDate);
  const allDay = data.allDay ?? false;
  const fallbackEndDate = allDay
    ? new Date(startDate.getTime() + 24 * 60 * 60 * 1000)
    : new Date(startDate.getTime() + 2 * 60 * 60 * 1000);
  const baseEndDate = data.endDate ? new Date(data.endDate) : fallbackEndDate;
  const durationMs = baseEndDate.getTime() - startDate.getTime();

  if (!data.recurrence) {
    return [buildOccurrence(startDate, durationMs, allDay)];
  }

  const until = new Date(data.recurrence.until);
  const interval = data.recurrence.interval ?? 1;
  const allowedMonths = data.recurrence.months
    ? new Set(data.recurrence.months)
    : null;
  const overrides = data.recurrence.overrides ?? [];
  const overridesByOriginalDate = new Map(
    overrides.map((override) => [new Date(override.originalDate).getTime(), override])
  );

  if (data.recurrence.frequency === "weekly") {
    const occurrences = [];
    let current = cloneDate(startDate);

    while (current <= until) {
      const currentStart = cloneDate(current);
      const override = overridesByOriginalDate.get(currentStart.getTime());

      if (override) {
        const overrideStart = new Date(override.startDate);
        const overrideEnd = override.endDate
          ? new Date(override.endDate)
          : new Date(overrideStart.getTime() + durationMs);
        occurrences.push(buildOccurrence(overrideStart, durationMs, allDay, overrideEnd));
      } else if (!allowedMonths || allowedMonths.has(currentStart.getMonth() + 1)) {
        occurrences.push(buildOccurrence(currentStart, durationMs, allDay));
      }

      current = addDays(current, interval * 7);
    }

    return occurrences;
  }

  const nth = data.recurrence.nth ?? 1;
  const weekday = startDate.getDay();
  const occurrences = [];
  let monthCursor = new Date(startDate.getFullYear(), startDate.getMonth(), 1);

  while (monthCursor <= until) {
    const occurrenceDate = getNthWeekdayDate(
      monthCursor.getFullYear(),
      monthCursor.getMonth(),
      weekday,
      nth
    );

    if (occurrenceDate) {
      const occurrenceStart = mergeDateAndTime(occurrenceDate, startDate);
      const override = overridesByOriginalDate.get(occurrenceStart.getTime());

      if (override) {
        const overrideStart = new Date(override.startDate);
        const overrideEnd = override.endDate
          ? new Date(override.endDate)
          : new Date(overrideStart.getTime() + durationMs);
        occurrences.push(buildOccurrence(overrideStart, durationMs, allDay, overrideEnd));
      } else if (
        occurrenceStart >= startDate &&
        occurrenceStart <= until &&
        (!allowedMonths || allowedMonths.has(occurrenceStart.getMonth() + 1))
      ) {
        occurrences.push(buildOccurrence(occurrenceStart, durationMs, allDay));
      }
    }

    monthCursor = addMonths(monthCursor, interval);
  }

  return occurrences;
}

const collectionEntries = await getCollection("cronograma");
const rawEntries = await Promise.all(
  collectionEntries.map(async (entry) => {
    const { Content } = await render(entry);

    return {
      id: entry.id,
      data: entry.data,
      Content
    };
  })
);

const events: EventEntry[] = rawEntries
  .filter((entry) => entry.data.published !== false)
  .flatMap((entry) =>
    expandOccurrences(entry.data).map((occurrence, index) => {
      const startDate = occurrence.startDate;
      const endDate = occurrence.endDate;
      const allDay = occurrence.allDay;

      return {
        id: `${entry.id}-${index + 1}`,
        sourceId: entry.id,
        parentSourceId: entry.data.parentId,
        title: entry.data.title,
        startDate,
        endDate,
        location: entry.data.location,
        summary: entry.data.summary,
        allDay,
        googleCalendarUrl: buildGoogleCalendarUrl({
          title: entry.data.title,
          startDate,
          endDate,
          location: entry.data.location,
          summary: entry.data.summary,
          allDay
        }),
        monthIndex: startDate.getMonth(),
        dayLabel: `${dayFormatter.format(startDate)} · ${weekdayFormatter.format(startDate)}`,
        timeLabel: allDay
          ? "Dia todo"
          : `${timeFormatter.format(startDate)} às ${timeFormatter.format(endDate)}`,
        Content: entry.Content
      };
    })
  )
  .sort((left, right) => left.startDate.getTime() - right.startDate.getTime());

const eventGroupsMap = new Map<string, EventGroup>();

for (const event of events) {
  if (event.parentSourceId) continue;
  eventGroupsMap.set(event.id, { ...event, subEvents: [] });
}

for (const event of events) {
  if (!event.parentSourceId) continue;

  const parentGroup = Array.from(eventGroupsMap.values()).find(
    (candidate) =>
      candidate.sourceId === event.parentSourceId &&
      candidate.startDate.getTime() === event.startDate.getTime() &&
      candidate.endDate.getTime() === event.endDate.getTime()
  );

  if (parentGroup) {
    parentGroup.subEvents.push(event);
    continue;
  }

  eventGroupsMap.set(event.id, { ...event, subEvents: [] });
}

const eventGroups = Array.from(eventGroupsMap.values()).sort(
  (left, right) => left.startDate.getTime() - right.startDate.getTime()
);

function buildCalendarDays(year: number, monthIndex: number, monthEvents: EventGroup[]) {
  const firstDayOfMonth = new Date(year, monthIndex, 1);
  const gridStart = new Date(year, monthIndex, 1 - firstDayOfMonth.getDay());
  const eventsByDay = new Map<string, EventGroup[]>();

  monthEvents.forEach((event) => {
    const key = toDateKey(event.startDate);
    const current = eventsByDay.get(key) ?? [];
    current.push(event);
    eventsByDay.set(key, current);
  });

  return Array.from({ length: 42 }, (_, offset) => {
    const currentDate = addDays(gridStart, offset);
    const key = toDateKey(currentDate);

    return {
      key,
      dayNumber: currentDate.getDate(),
      isCurrentMonth: currentDate.getMonth() === monthIndex,
      events: eventsByDay.get(key) ?? []
    };
  });
}

const months: CalendarMonth[] = monthLabels.map((label, monthIndex) => {
  const monthEvents = eventGroups.filter(
    (event) =>
      event.startDate.getFullYear() === calendarYear && event.monthIndex === monthIndex
  );

  return {
    label,
    monthIndex,
    year: calendarYear,
    events: monthEvents,
    days: buildCalendarDays(calendarYear, monthIndex, monthEvents)
  };
});
const currentMonthIndex = new Date().getMonth();
---

<BaseLayout
  title="Agenda | 5IEQ Vila Arlindo"
  description="Calendário anual com os eventos divulgados pela 5IEQ Vila Arlindo."
>
  <section class="site-container pb-12 pt-28 sm:pb-16 sm:pt-32">
    <div class="page-hero p-8 sm:p-12">
      <span class="icon-badge" aria-hidden="true">
        <CalendarDays class="icon-svg-lg" stroke-width={1.9} />
      </span>
      <p class="mt-6 section-kicker">Agenda Anual</p>
      <h1 class="mt-4 font-serif text-5xl font-semibold leading-[0.92] tracking-[-0.04em] text-text sm:text-6xl">
        Acompanhe os eventos da igreja ao longo do ano.
      </h1>
      <p class="mt-6 max-w-3xl section-copy">
        Esta página reúne a programação da igreja em um calendário simples de consultar. Navegue
        pelos meses, clique nos dias com evento para localizar a programação correspondente e abra
        cada card para ver detalhes, horários, local e opção de adicionar à sua agenda.
      </p>
      <div class="eyebrow-rule"></div>
    </div>
  </section>

  <section class="site-container pb-12 sm:pb-16">
    <div class="section-card p-5 sm:p-8 sm:pb-10">
      <div>
        <p class="section-kicker">Calendário</p>
        <h2 class="mt-3 font-serif text-3xl font-semibold text-text sm:text-4xl">
          Visualize os eventos no mês e navegue pelo ano.
        </h2>
      </div>

      <div class="calendar-carousel-viewport" data-calendar-root>
        <div class="calendar-track" data-calendar-track>
        {
          months.map((month) => (
            <section
              class="calendar-panel"
              data-calendar-panel
              data-month-index={month.monthIndex}
              aria-hidden="true"
            >
              <div class="calendar-month-header">
                <div>
                  <p class="section-kicker">Mês em destaque</p>
                  <h3 class="mt-3 font-serif text-4xl font-semibold text-text">
                    {month.label} {month.year}
                  </h3>
                </div>
                <p class="calendar-month-meta">{month.events.length} evento(s) neste mês</p>
              </div>

              <div class="calendar-scroll">
                <div class="calendar-shell">
                  <div class="calendar-weekdays" aria-hidden="true">
                    {weekdayShortLabels.map((weekday) => <span>{weekday}</span>)}
                  </div>

                  <div class="calendar-grid">
                    {
                      month.days.map((day) =>
                        day.isCurrentMonth ? (
                          day.events.length > 0 ? (
                            <div class="calendar-day-shell" data-date={`${month.year}-${month.monthIndex + 1}-${day.dayNumber}`}>
                              <button
                                type="button"
                                class="calendar-day calendar-day-has-events"
                                data-calendar-target-month={`mes-${month.monthIndex + 1}`}
                                data-calendar-target-event={day.events[0]?.id}
                                data-calendar-event-count={day.events.length}
                                aria-label={`Ver eventos de ${day.dayNumber} de ${month.label}`}
                                aria-expanded="false"
                              >
                                <span class="calendar-day-number">{day.dayNumber}</span>
                                <span class="calendar-day-dot" aria-hidden="true"></span>
                              </button>

                              {
                                day.events.length > 1 && (
                                  <div class="calendar-day-popover" hidden data-calendar-popover>
                                    <p class="calendar-day-popover-title">Escolha o evento</p>
                                    <div class="calendar-day-popover-list">
                                      {day.events.map((event) => (
                                        <button
                                          type="button"
                                          class="calendar-popover-option"
                                          data-calendar-target-month={`mes-${month.monthIndex + 1}`}
                                          data-calendar-target-event={event.id}
                                        >
                                          <span class="calendar-popover-option-title">{event.title}</span>
                                          <span class="calendar-popover-option-meta">{event.timeLabel}</span>
                                        </button>
                                      ))}
                                    </div>
                                  </div>
                                )
                              }
                            </div>
                          ) : (
                            <div class="calendar-day" aria-hidden="true" data-date={`${month.year}-${month.monthIndex + 1}-${day.dayNumber}`}>
                              <span class="calendar-day-number">{day.dayNumber}</span>
                            </div>
                          )
                        ) : (
                          <div class="calendar-day calendar-day-outside" aria-hidden="true">
                            <span class="calendar-day-number">{day.dayNumber}</span>
                          </div>
                        )
                      )
                    }
                  </div>
                </div>
              </div>
            </section>
          ))
        }
        </div>
      </div>

      <div class="calendar-controls" aria-label="Navegação entre meses">
        <button type="button" class="calendar-nav-button" data-calendar-prev aria-label="Mês anterior">
          <ChevronLeft class="icon-svg" stroke-width={1.9} />
        </button>
        <div class="calendar-dots">
          {months.map((month, i) => (
            <button
              type="button"
              class:list={["calendar-dot", i === currentMonthIndex && "is-active"]}
              data-dot-index={i}
              aria-label={`Ir para ${month.label}`}
            ></button>
          ))}
        </div>
        <button type="button" class="calendar-nav-button" data-calendar-next aria-label="Próximo mês">
          <ChevronRight class="icon-svg" stroke-width={1.9} />
        </button>
      </div>
    </div>
  </section>

  {
    eventGroups.length === 0 && (
      <section class="site-container pb-12 sm:pb-16">
        <div class="section-card p-8 sm:p-10">
          <p class="section-kicker">Sem eventos publicados</p>
          <h2 class="mt-4 font-serif text-4xl font-semibold leading-none text-text">
            A agenda está pronta para receber os próximos eventos da igreja.
          </h2>
          <div class="mt-6 markdown-copy max-w-3xl">
            <p>
              Para adicionar um evento, crie um arquivo Markdown em
              <code> src/content/cronograma/</code> seguindo o modelo disponível em
              <code> src/content/cronograma/_template.md.txt</code>.
            </p>
            <p>
              Assim que o arquivo for salvo com <code>title</code> e <code>startDate</code>, o
              evento aparece automaticamente nesta página.
            </p>
          </div>
        </div>
      </section>
    )
  }

  <section class="site-container pb-16 sm:pb-20">
    <div class="space-y-8">
      {
        months.map((month) => (
          <details
            id={`mes-${month.monthIndex + 1}`}
            class="month-collapse"
            open={month.monthIndex === currentMonthIndex}
          >
            <summary class="month-summary">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between sm:gap-6">
                <div>
                  <p class="section-kicker">Mês</p>
                  <h2 class="mt-3 font-serif text-4xl font-semibold text-text">{month.label}</h2>
                </div>
                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-muted">
                  {month.events.length} evento(s)
                </p>
              </div>
              <span class="month-chevron" aria-hidden="true">
                <ChevronDown class="icon-svg" stroke-width={1.9} />
              </span>
            </summary>

            <div class="month-content">
              {
                month.events.length > 0 ? (
                  <div class="space-y-3">
                    {month.events.map((event) => (
                      <button
                        id={`evento-lista-${event.id}`}
                        type="button"
                        class="event-row"
                        data-dialog-target={event.id}
                        aria-label={`Abrir detalhes de ${event.title}`}
                      >
                        <span class="event-row-date">
                          <span class="section-kicker">Dia</span>
                          <span class="mt-1 text-2xl font-semibold text-text">{event.dayLabel.split(" · ")[0]}</span>
                        </span>
                        <span class="min-w-0 flex-1">
                          <span class="event-row-title block">{event.title}</span>
                          <span class="event-row-meta mt-1 block">
                            {event.dayLabel} · {event.timeLabel}
                          </span>
                          {
                            event.subEvents.length > 0 && (
                              <span class="event-subcards mt-4 flex flex-col gap-3">
                                {event.subEvents.map((subEvent) => (
                                  <span class="event-subcard">
                                    <span class="block font-serif text-xl font-semibold text-text">
                                      {subEvent.title}
                                    </span>
                                    <span class="event-row-meta mt-1 hidden sm:block">
                                      {subEvent.summary ?? subEvent.timeLabel}
                                    </span>
                                  </span>
                                ))}
                              </span>
                            )
                          }
                        </span>
                        <span class="icon-badge-sm shrink-0" aria-hidden="true">
                          <MoveRight class="icon-svg" stroke-width={1.9} />
                        </span>
                      </button>
                    ))}
                  </div>
                ) : (
                  <div class="info-item">
                    <p class="text-base leading-7 text-muted">Nenhum evento publicado neste mês.</p>
                  </div>
                )
              }

              {
                month.events.length > 0 &&
                  month.events.map((event) => (
                    <dialog class="event-dialog" data-dialog-id={event.id} aria-labelledby={`evento-${event.id}-titulo`}>
                      <div class="event-dialog-card">
                        <div class="flex items-start justify-between gap-4">
                          <div class="flex items-center gap-4">
                            <span class="icon-badge" aria-hidden="true">
                              <CalendarDays class="icon-svg-lg" stroke-width={1.9} />
                            </span>
                            <div>
                              <p class="section-kicker">Dia {event.dayLabel}</p>
                              <h3 id={`evento-${event.id}-titulo`} class="mt-2 font-serif text-4xl font-semibold text-text">
                                {event.title}
                              </h3>
                            </div>
                          </div>

                          <button type="button" class="dialog-close" data-dialog-close aria-label="Fechar detalhes do evento">
                            <X class="icon-svg" stroke-width={1.9} />
                          </button>
                        </div>

                        <div class="mt-8 grid gap-4 sm:grid-cols-2">
                          <div class="info-item">
                            <div class="icon-card-row">
                              <span class="icon-badge-sm" aria-hidden="true">
                                <Clock class="icon-svg" stroke-width={1.9} />
                              </span>
                              <div>
                                <p class="section-kicker">Horário</p>
                                <p class="mt-2 text-base leading-7 text-muted">{event.timeLabel}</p>
                              </div>
                            </div>
                          </div>

                          <div class="info-item">
                            <div class="icon-card-row">
                              <span class="icon-badge-sm" aria-hidden="true">
                                <MapPin class="icon-svg" stroke-width={1.9} />
                              </span>
                              <div>
                                <p class="section-kicker">Local</p>
                                <p class="mt-2 text-base leading-7 text-muted">
                                  {event.location ?? "Consulte a igreja"}
                                </p>
                              </div>
                            </div>
                          </div>
                        </div>

                        <div class="mt-6 markdown-copy">
                          {event.summary && <p>{event.summary}</p>}
                          <event.Content />
                        </div>

                        {
                          event.subEvents.length > 0 && (
                            <div class="mt-8 space-y-4">
                              <p class="section-kicker">Programação paralela</p>
                              {event.subEvents.map((subEvent) => (
                                <section class="info-item">
                                  <h4 class="font-serif text-2xl font-semibold text-text">
                                    {subEvent.title}
                                  </h4>
                                  <p class="mt-3 text-base leading-7 text-muted">
                                    {subEvent.summary ?? "Programação complementar deste encontro."}
                                  </p>
                                  <div class="mt-4 markdown-copy">
                                    <subEvent.Content />
                                  </div>
                                </section>
                              ))}
                            </div>
                          )
                        }

                        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                          <a
                            href={event.googleCalendarUrl}
                            target="_blank"
                            rel="noreferrer"
                            class="button-primary"
                          >
                            Adicionar ao Google Agenda
                          </a>
                          <button type="button" class="button-secondary" data-dialog-close>
                            Fechar
                          </button>
                        </div>
                      </div>
                    </dialog>
                  ))
              }
            </div>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const calendarPanels = document.querySelectorAll("[data-calendar-panel]");
  const calendarTrack = document.querySelector("[data-calendar-track]");
  const calendarViewport = document.querySelector("[data-calendar-root]");
  const previousMonthButton = document.querySelector("[data-calendar-prev]");
  const nextMonthButton = document.querySelector("[data-calendar-next]");
  const calendarDots = document.querySelectorAll("[data-dot-index]");
  const dialogs = document.querySelectorAll("[data-dialog-id]");
  const openButtons = document.querySelectorAll("[data-dialog-target]");
  const closeButtons = document.querySelectorAll("[data-dialog-close]");
  const calendarTargetButtons = document.querySelectorAll("[data-calendar-target-month]");
  const calendarPopovers = document.querySelectorAll("[data-calendar-popover]");

  const totalMonths = calendarPanels.length;
  let activeMonthIndex = Number(
    Array.from(calendarPanels).findIndex((p) => p.getAttribute("data-month-index") === String(new Date().getMonth()))
  );
  if (activeMonthIndex < 0) activeMonthIndex = 0;

  const syncCalendarPanels = () => {
    if (calendarTrack instanceof HTMLElement) {
      calendarTrack.style.transform = `translateX(-${activeMonthIndex * 100}%)`;
    }
    calendarPanels.forEach((panel, i) => {
      panel.setAttribute("aria-hidden", i === activeMonthIndex ? "false" : "true");
    });
    calendarDots.forEach((dot, i) => {
      dot.classList.toggle("is-active", i === activeMonthIndex);
    });
    if (previousMonthButton instanceof HTMLButtonElement) {
      previousMonthButton.disabled = activeMonthIndex === 0;
    }
    if (nextMonthButton instanceof HTMLButtonElement) {
      nextMonthButton.disabled = activeMonthIndex === totalMonths - 1;
    }
  };

  previousMonthButton?.addEventListener("click", () => {
    if (activeMonthIndex > 0) { activeMonthIndex--; syncCalendarPanels(); }
  });

  nextMonthButton?.addEventListener("click", () => {
    if (activeMonthIndex < totalMonths - 1) { activeMonthIndex++; syncCalendarPanels(); }
  });

  calendarDots.forEach((dot) => {
    dot.addEventListener("click", () => {
      const idx = Number(dot.getAttribute("data-dot-index"));
      if (!isNaN(idx)) { activeMonthIndex = idx; syncCalendarPanels(); }
    });
  });

  let touchStartX = 0;
  calendarViewport?.addEventListener("touchstart", (e) => {
    touchStartX = e.changedTouches[0].clientX;
  }, { passive: true });
  calendarViewport?.addEventListener("touchend", (e) => {
    const diff = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 40) {
      if (diff > 0 && activeMonthIndex < totalMonths - 1) activeMonthIndex++;
      else if (diff < 0 && activeMonthIndex > 0) activeMonthIndex--;
      syncCalendarPanels();
    }
  }, { passive: true });

  const closeAllCalendarPopovers = () => {
    calendarPopovers.forEach((popover) => {
      if (!(popover instanceof HTMLElement)) return;
      popover.hidden = true;
      const trigger = popover.parentElement?.querySelector("[data-calendar-event-count]");
      if (trigger instanceof HTMLElement) {
        trigger.setAttribute("aria-expanded", "false");
      }
    });
  };

  const focusCalendarEvent = (targetMonthId, targetEventId) => {
    const monthDetails = targetMonthId ? document.getElementById(targetMonthId) : null;
    const eventRow = targetEventId ? document.getElementById(`evento-lista-${targetEventId}`) : null;

    if (monthDetails instanceof HTMLDetailsElement) {
      monthDetails.open = true;
    }

    const scrollTarget = eventRow ?? monthDetails;
    scrollTarget?.scrollIntoView({ behavior: "smooth", block: "center" });

    if (eventRow instanceof HTMLElement) {
      eventRow.classList.add("is-linked");
      window.setTimeout(() => {
        eventRow.classList.remove("is-linked");
      }, 2600);
    }
  };

  calendarTargetButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const eventCount = Number(button.getAttribute("data-calendar-event-count") ?? "1");
      const targetMonthId = button.getAttribute("data-calendar-target-month");
      const targetEventId = button.getAttribute("data-calendar-target-event");

      if (eventCount > 1) {
        const popover = button.parentElement?.querySelector("[data-calendar-popover]");
        const willOpen = popover instanceof HTMLElement ? popover.hidden : false;
        closeAllCalendarPopovers();

        if (popover instanceof HTMLElement) {
          popover.hidden = !willOpen;
          button.setAttribute("aria-expanded", willOpen ? "true" : "false");
        }

        return;
      }

      closeAllCalendarPopovers();
      focusCalendarEvent(targetMonthId, targetEventId);
    });
  });

  calendarPopovers.forEach((popover) => {
    if (!(popover instanceof HTMLElement)) return;

    const options = popover.querySelectorAll("[data-calendar-target-event]");
    options.forEach((option) => {
      option.addEventListener("click", () => {
        const targetMonthId = option.getAttribute("data-calendar-target-month");
        const targetEventId = option.getAttribute("data-calendar-target-event");
        closeAllCalendarPopovers();
        focusCalendarEvent(targetMonthId, targetEventId);
      });
    });
  });

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (target.closest(".calendar-day-shell")) return;
    closeAllCalendarPopovers();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeAllCalendarPopovers();
    }
  });

  openButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const targetId = button.getAttribute("data-dialog-target");
      const dialog = document.querySelector(`[data-dialog-id="${targetId}"]`);
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    });
  });

  closeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const dialog = button.closest("dialog");
      if (dialog instanceof HTMLDialogElement) dialog.close();
    });
  });

  dialogs.forEach((dialog) => {
    if (!(dialog instanceof HTMLDialogElement)) return;
    dialog.addEventListener("click", (event) => {
      const rect = dialog.getBoundingClientRect();
      const isInside =
        rect.top <= event.clientY &&
        event.clientY <= rect.top + rect.height &&
        rect.left <= event.clientX &&
        event.clientX <= rect.left + rect.width;

      if (!isInside) dialog.close();
    });
  });

  syncCalendarPanels();

  const today = new Date();
  const todayStr = `${today.getFullYear()}-${today.getMonth() + 1}-${today.getDate()}`;
  const todayCell = document.querySelector(`[data-date="${todayStr}"]`);
  if (todayCell instanceof HTMLElement) {
    todayCell.classList.add("calendar-day-today");
  }
</script>
